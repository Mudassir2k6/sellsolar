{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sellsolar.pk" }],
      "destination": "https://sellsolar.pk/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/home.html", "destination": "/", "permanent": true },
    { "source": "/home.php", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/prices", "destination": "/index.html" },
    { "source": "/today-prices", "destination": "/index.html" },
    { "source": "/calculator", "destination": "/index.html" },
    { "source": "/load-calculator", "destination": "/index.html" },
    { "source": "/dealers", "destination": "/index.html" },
    { "source": "/install", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/post-ad", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin-dashboard", "destination": "/index.html" },
    { "source": "/password", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/change-password", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/about-us", "destination": "/index.html" },
    { "source": "/careers", "destination": "/index.html" },
    { "source": "/press", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/buy-solar", "destination": "/index.html" },
    { "source": "/sell-solar", "destination": "/index.html" },
    { "source": "/how-it-works", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" },
    { "source": "/help-center", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/contact-us", "destination": "/index.html" },
    { "source": "/safety", "destination": "/index.html" },
    { "source": "/safety-tips", "destination": "/index.html" },
    { "source": "/report", "destination": "/index.html" },
    { "source": "/report-issue", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/terms-of-service", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/cookies", "destination": "/index.html" },
    { "source": "/cookie-policy", "destination": "/index.html" },
    { "source": "/disclaimer", "destination": "/index.html" },
    { "source": "/listing/:id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|svg|webp|woff2|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
