/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate
  X-SellSolar-Framework: nextjs

# Hashed build assets never change, so they must be cached hard (browser + CDN).
# Cloudflare MERGES matching rules, so the "/*" no-cache values above are detached first;
# otherwise assets got "max-age=0, must-revalidate" + "max-age=31536000" together and every
# refresh re-validated every file over the network (very slow on weak connections).
/_next/static/*
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/_next/static/media/*
  Access-Control-Allow-Origin: *

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=604800

/favicon*
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/og-image*
  Cache-Control: public, max-age=86400

/build-version.json
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/cf-status.json
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
